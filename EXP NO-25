# RSA - Factoring n using a plaintext block that shares
# a common factor with n

import math

# Public RSA values
n = 3233
e = 17

# Suppose someone tells us that one plaintext block
# has a common factor with n.
# For example, m = 187
m = 187

print("Public Key:")
print("e =", e)
print("n =", n)

print("\nKnown plaintext block:")
print("m =", m)

# Step 1: Calculate gcd(m, n)
g = math.gcd(m, n)

print("\ngcd(m, n) =", g)

# Step 2: Check whether we have found a factor
if g == 1 or g == n:
    print("No useful factor of n was found.")
else:
    # g is one prime factor
    p = g
    q = n // p

    print("\nFactorization of n:")
    print("p =", p)
    print("q =", q)

    # Step 3: Calculate Euler's totient
    phi = (p - 1) * (q - 1)

    print("\nphi(n) =", phi)

    # Step 4: Find private key d
    # d is the multiplicative inverse of e modulo phi(n)

    def extended_gcd(a, b):
        if b == 0:
            return a, 1, 0

        gcd, x1, y1 = extended_gcd(b, a % b)

        x = y1
        y = x1 - (a // b) * y1

        return gcd, x, y

    gcd_value, x, y = extended_gcd(e, phi)

    if gcd_value != 1:
        print("Private key cannot be calculated.")
    else:
        d = x % phi

        print("Private key d =", d)

        print("\nRecovered Keys:")
        print("Public Key  =", (e, n))
        print("Private Key =", (d, n))
