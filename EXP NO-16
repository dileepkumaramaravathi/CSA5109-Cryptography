import random
import math
from collections import Counter

# English letter frequencies
ENGLISH_FREQ = {
    'A': 8.167, 'B': 1.492, 'C': 2.782, 'D': 4.253,
    'E': 12.702, 'F': 2.228, 'G': 2.015, 'H': 6.094,
    'I': 6.966, 'J': 0.153, 'K': 0.772, 'L': 4.025,
    'M': 2.406, 'N': 6.749, 'O': 7.507, 'P': 1.929,
    'Q': 0.095, 'R': 5.987, 'S': 6.327, 'T': 9.056,
    'U': 2.758, 'V': 0.978, 'W': 2.360, 'X': 0.150,
    'Y': 1.974, 'Z': 0.074
}

# Common English letter pairs
COMMON_PAIRS = [
    "TH", "HE", "IN", "ER", "AN", "RE", "ON", "AT",
    "EN", "ND", "TI", "ES", "OR", "TE", "OF", "ED",
    "IS", "IT", "AL", "AR", "ST", "TO", "NT", "NG"
]

# Common English words/patterns
COMMON_WORDS = [
    "THE", "AND", "THAT", "THIS", "WITH", "FROM",
    "HAVE", "WILL", "YOUR", "ARE", "FOR", "NOT",
    "BUT", "YOU", "ALL", "CAN", "HER", "WAS"
]


def decrypt(ciphertext, key):
    """
    key[cipher_letter] = plaintext_letter
    """
    result = ""

    for ch in ciphertext:
        if ch.isalpha():
            result += key[ord(ch.upper()) - ord('A')]
        else:
            result += ch

    return result


def score_text(text):
    """
    Score how closely the text resembles English.
    Higher score = more likely to be English.
    """

    letters = ''.join(c for c in text.upper() if c.isalpha())

    if not letters:
        return -1000000

    score = 0.0

    # Frequency score
    counts = Counter(letters)
    total = len(letters)

    for letter in "ABCDEFGHIJKLMNOPQRSTUVWXYZ":
        observed = counts[letter] / total
        expected = ENGLISH_FREQ[letter] / 100

        # Reward letters occurring near English frequency
        score -= abs(observed - expected) * 100

    # Common two-letter combinations
    for pair in COMMON_PAIRS:
        score += text.upper().count(pair) * 2

    # Common English words
    words = text.upper().split()

    for word in words:
        if word in COMMON_WORDS:
            score += 15

    return score


def random_key():
    letters = list("ABCDEFGHIJKLMNOPQRSTUVWXYZ")
    random.shuffle(letters)
    return letters


def improve_key(ciphertext, key, iterations=20000):
    best_key = key[:]
    best_plaintext = decrypt(ciphertext, best_key)
    best_score = score_text(best_plaintext)

    current_key = best_key[:]
    current_score = best_score

    for i in range(iterations):

        # Make a small change to the substitution key
        new_key = current_key[:]

        a = random.randint(0, 25)
        b = random.randint(0, 25)

        new_key[a], new_key[b] = new_key[b], new_key[a]

        plaintext = decrypt(ciphertext, new_key)
        new_score = score_text(plaintext)

        # Temperature decreases gradually
        temperature = 20 * (1 - i / iterations) + 0.1

        if new_score > current_score:
            current_key = new_key
            current_score = new_score
        else:
            probability = math.exp(
                (new_score - current_score) / temperature
            )

            if random.random() < probability:
                current_key = new_key
                current_score = new_score

        if current_score > best_score:
            best_key = current_key[:]
            best_score = current_score

    return best_score, best_key


def frequency_attack(ciphertext, top_n):
    results = []

    # Multiple random attempts
    attempts = max(20, top_n * 5)

    for _ in range(attempts):

        key = random_key()

        score, key = improve_key(
            ciphertext,
            key,
            iterations=10000
        )

        plaintext = decrypt(ciphertext, key)

        results.append((score, plaintext, key))

    # Remove duplicate plaintexts
    unique = {}

    for score, plaintext, key in results:
        if plaintext not in unique or score > unique[plaintext][0]:
            unique[plaintext] = (score, key)

    results = []

    for plaintext, (score, key) in unique.items():
        results.append((score, plaintext, key))

    # Highest score first
    results.sort(reverse=True, key=lambda x: x[0])

    return results[:top_n]


