# S-DES CBC MODE
# Encryption and Decryption
# No external libraries required

# --------------------------------------------------
# S-DES TABLES
# --------------------------------------------------

P10 = [3, 5, 2, 7, 4, 10, 1, 9, 8, 6]

P8 = [6, 3, 7, 4, 8, 5, 10, 9]

IP = [2, 6, 3, 1, 4, 8, 5, 7]

IP_INV = [4, 1, 3, 5, 7, 2, 8, 6]

EP = [4, 1, 2, 3, 2, 3, 4, 1]

P4 = [2, 4, 3, 1]

S0 = [
    [1, 0, 3, 2],
    [3, 2, 1, 0],
    [0, 2, 1, 3],
    [3, 1, 3, 2]
]

S1 = [
    [0, 1, 2, 3],
    [2, 0, 1, 3],
    [3, 0, 1, 0],
    [2, 1, 0, 3]
]


# --------------------------------------------------
# PERMUTATION
# --------------------------------------------------

def permute(bits, table):
    return ''.join(bits[i - 1] for i in table)


# --------------------------------------------------
# LEFT CIRCULAR SHIFT
# --------------------------------------------------

def left_shift(bits, n):
    return bits[n:] + bits[:n]


# --------------------------------------------------
# XOR
# --------------------------------------------------

def xor_bits(a, b):
    return ''.join(
        str(int(x) ^ int(y))
        for x, y in zip(a, b)
    )


# --------------------------------------------------
# KEY GENERATION
# --------------------------------------------------

def generate_keys(key):

    # P10
    key = permute(key, P10)

    left = key[:5]
    right = key[5:]

    # LS-1
    left = left_shift(left, 1)
    right = left_shift(right, 1)

    K1 = permute(left + right, P8)

    # LS-2
    left = left_shift(left, 2)
    right = left_shift(right, 2)

    K2 = permute(left + right, P8)

    return K1, K2


# --------------------------------------------------
# S-BOX
# --------------------------------------------------

def sbox(bits, box):

    row = int(bits[0] + bits[3], 2)
    column = int(bits[1] + bits[2], 2)

    value = box[row][column]

    return format(value, '02b')


# --------------------------------------------------
# F FUNCTION
# --------------------------------------------------

def fk(bits, key):

    left = bits[:4]
    right = bits[4:]

    # Expansion permutation
    expanded = permute(right, EP)

    # XOR with key
    xored = xor_bits(expanded, key)

    # Split into two 4-bit parts
    left4 = xored[:4]
    right4 = xored[4:]

    # S-box substitution
    sbox_output = sbox(left4, S0) + sbox(right4, S1)

    # P4
    p4_output = permute(sbox_output, P4)

    # XOR with left half
    new_left = xor_bits(left, p4_output)

    return new_left + right


# --------------------------------------------------
# S-DES ENCRYPTION
# --------------------------------------------------

def sdes_encrypt(block, key):

    K1, K2 = generate_keys(key)

    # Initial permutation
    bits = permute(block, IP)

    # Round 1
    bits = fk(bits, K1)

    # Swap halves
    bits = bits[4:] + bits[:4]

    # Round 2
    bits = fk(bits, K2)

    # Inverse initial permutation
    ciphertext = permute(bits, IP_INV)

    return ciphertext


# --------------------------------------------------
# S-DES DECRYPTION
# --------------------------------------------------

def sdes_decrypt(block, key):

    K1, K2 = generate_keys(key)

    # Reverse key order
    bits = permute(block, IP)

    # Round 1 with K2
    bits = fk(bits, K2)

    # Swap halves
    bits = bits[4:] + bits[:4]

    # Round 2 with K1
    bits = fk(bits, K1)

    # Inverse initial permutation
    plaintext = permute(bits, IP_INV)

    return plaintext


# --------------------------------------------------
# CBC ENCRYPTION
# --------------------------------------------------

def cbc_encrypt(plaintext, key, iv):

    ciphertext = ''
    previous = iv

    for i in range(0, len(plaintext), 8):

        block = plaintext[i:i + 8]

        # CBC:
        # C[i] = E(P[i] XOR C[i-1])
        xored = xor_bits(block, previous)

        encrypted = sdes_encrypt(xored, key)

        ciphertext += encrypted

        previous = encrypted

    return ciphertext


# --------------------------------------------------
# CBC DECRYPTION
# --------------------------------------------------

def cbc_decrypt(ciphertext, key, iv):

    plaintext = ''
    previous = iv

    for i in range(0, len(ciphertext), 8):

        block = ciphertext[i:i + 8]

        # Decrypt first
        decrypted = sdes_decrypt(block, key)

        # CBC:
        # P[i] = D(C[i]) XOR C[i-1]
        original = xor_bits(decrypted, previous)

        plaintext += original

        previous = block

    return plaintext


# --------------------------------------------------
# MAIN PROGRAM
# --------------------------------------------------

print("S-DES CBC MODE")
print("==============")

plaintext = input(
    "Enter binary plaintext (multiple of 8 bits): "
).replace(" ", "")

key = input(
    "Enter 10-bit binary key: "
).replace(" ", "")

iv = input(
    "Enter 8-bit binary IV: "
).replace(" ", "")


# --------------------------------------------------
# INPUT VALIDATION
# --------------------------------------------------

if any(c not in "01" for c in plaintext):
    print("Error: Plaintext must contain only 0 and 1.")

elif len(plaintext) == 0 or len(plaintext) % 8 != 0:
    print("Error: Plaintext length must be a positive multiple of 8.")

elif len(key) != 10 or any(c not in "01" for c in key):
    print("Error: Key must contain exactly 10 binary bits.")

elif len(iv) != 8 or any(c not in "01" for c in iv):
    print("Error: IV must contain exactly 8 binary bits.")

else:

    print("\n------------------------------")
    print("ENCRYPTION")
    print("------------------------------")

    ciphertext = cbc_encrypt(
        plaintext,
        key,
        iv
    )

    print("Plaintext : ", plaintext)
    print("IV        : ", iv)
    print("Key       : ", key)
    print("Ciphertext: ", ciphertext)

    print("\n------------------------------")
    print("DECRYPTION")
    print("------------------------------")

    recovered = cbc_decrypt(
        ciphertext,
        key,
        iv
    )

    print("Ciphertext: ", ciphertext)
    print("IV        : ", iv)
    print("Key       : ", key)
    print("Plaintext : ", recovered)

    print("\n------------------------------")

    if recovered == plaintext:
        print("SUCCESS: Decryption recovered the original plaintext.")
    else:
        print("ERROR: Decryption failed.")
