# DES SUBKEY GENERATION
# First 24 bits of each subkey come from C
# Second 24 bits come from D

# PC-1: 64-bit key -> 56-bit key
PC1 = [
    57, 49, 41, 33, 25, 17, 9,
    1, 58, 50, 42, 34, 26, 18,
    10, 2, 59, 51, 43, 35, 27,
    19, 11, 3, 60, 52, 44, 36,
    63, 55, 47, 39, 31, 23, 15,
    7, 62, 54, 46, 38, 30, 22,
    14, 6, 61, 53, 45, 37, 29,
    21, 13, 5, 28, 20, 12, 4
]

# PC-2
# 48-bit subkey is generated from 56-bit C + D
PC2 = [
    14, 17, 11, 24, 1, 5,
    3, 28, 15, 6, 21, 10,
    23, 19, 12, 4, 26, 8,
    16, 7, 27, 20, 13, 2,
    41, 52, 31, 37, 47, 55,
    30, 40, 51, 45, 33, 48,
    44, 49, 39, 56, 34, 53,
    46, 42, 50, 36, 29, 32
]

# DES left-shift schedule
SHIFTS = [
    1, 1, 2, 2, 2, 2, 2, 2,
    1, 2, 2, 2, 2, 2, 2, 1
]


def hex_to_binary(hex_key):
    return bin(int(hex_key, 16))[2:].zfill(64)


def permute(bits, table):
    return ''.join(bits[i - 1] for i in table)


def left_shift(bits, shift):
    return bits[shift:] + bits[:shift]


def generate_subkeys(hex_key):

    # Convert 64-bit hexadecimal key to binary
    key_bits = hex_to_binary(hex_key)

    print("\n64-bit Initial Key:")
    print(key_bits)

    # Apply PC-1
    key_56 = permute(key_bits, PC1)

    print("\n56-bit Key after PC-1:")
    print(key_56)

    # Divide into two 28-bit subsets
    C = key_56[:28]
    D = key_56[28:]

    print("\nInitial C0:")
    print(C)

    print("\nInitial D0:")
    print(D)

    subkeys = []

    # Generate 16 subkeys
    for round_number in range(16):

        shift = SHIFTS[round_number]

        # Shift both subsets
        C = left_shift(C, shift)
        D = left_shift(D, shift)

        # Combine C and D
        combined = C + D

        # Apply PC-2
        subkey = permute(combined, PC2)

        subkeys.append(subkey)

        # First 24 bits and second 24 bits
        first_24 = subkey[:24]
        second_24 = subkey[24:]

        print("\nRound", round_number + 1)
        print("Shift :", shift)

        print("C{}    :".format(round_number + 1), C)
        print("D{}    :".format(round_number + 1), D)

        print("First 24 bits : ", first_24)
        print("Second 24 bits:", second_24)

        print("K{} (48 bits) :".format(round_number + 1), subkey)

    return subkeys


# ------------------------------------------------
# MAIN PROGRAM
# ------------------------------------------------

key = input("Enter 16-digit hexadecimal DES key: ").strip().upper()

# Validate input
while len(key) != 16:
    print("Error! DES key must contain exactly 16 hexadecimal digits.")
    key = input("Enter 16-digit hexadecimal DES key: ").strip().upper()

try:
    int(key, 16)
except ValueError:
    print("Error! Key must contain only hexadecimal characters (0-9, A-F).")
    exit()

print("\nDES KEY GENERATION")
print("==================")

subkeys = generate_subkeys(key)

print("\n\nFINAL 16 SUBKEYS")
print("================")

for i, subkey in enumerate(subkeys, 1):

    first_24 = subkey[:24]
    second_24 = subkey[24:]

    print("\nK{}:".format(i))
    print("First  24 bits:", first_24)
    print("Second 24 bits:", second_24)
    print("48-bit K{}     :".format(i), subkey)
